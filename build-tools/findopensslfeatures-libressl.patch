Replace the OpenSSL-internal EVP_PKEY_meth_* family with the public
EVP_PKEY_asn1_* family in findopensslfeatures.c. The meth family is not
exposed by LibreSSL, so the introspection tool fails to compile there.

Same approach was filed upstream as rnpgp/rnp#2440. Drop this patch
once a librnp release includes the fix.

--- a/cmake/Modules/findopensslfeatures.c
+++ b/cmake/Modules/findopensslfeatures.c
@@ -83,11 +83,11 @@ int
 list_publickey()
 {
 #if OPENSSL_VERSION_NUMBER < 0x30000000L
-    for (size_t i = 0; i < EVP_PKEY_meth_get_count(); i++) {
-        const EVP_PKEY_METHOD *pmeth = EVP_PKEY_meth_get0(i);
+    for (size_t i = 0; i < EVP_PKEY_asn1_get_count(); i++) {
+        const EVP_PKEY_ASN1_METHOD *ameth = EVP_PKEY_asn1_get0(i);
         int                    id = 0;
-        EVP_PKEY_meth_get0_info(&id, NULL, pmeth);
-        printf("%s\n", OBJ_nid2ln(id));
+        EVP_PKEY_asn1_get0_info(&id, NULL, NULL, NULL, NULL, ameth);
+        if (id != 0) {
+            printf("%s\n", OBJ_nid2ln(id));
+        }
     }
 #else
     EVP_KEYMGMT_do_all_provided(NULL, print_km, NULL);
